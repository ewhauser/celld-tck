{
  "version": 1,
  "scope": "Public API behavior on the pinned local workerd and celld releases. A representative contract corpus, not an exhaustive proof for every input or distributed schedule.",
  "families": [
    {
      "family": "http",
      "cases": [
        "http.request-response",
        "http.body-consumption",
        "http.headers",
        "http.url-formdata",
        "http.encoding",
        "http.abort",
        "http.redirect",
        "http.fetch-abort"
      ]
    },
    {
      "family": "storage",
      "cases": [
        "storage.round-trip",
        "storage.transaction-rollback",
        "storage.rich-values",
        "storage.batch-ranges",
        "storage.delete-all",
        "storage.transaction-commit",
        "storage.explicit-rollback",
        "storage.invalid-input",
        "storage.synchronous-kv",
        "storage.sync-committed"
      ]
    },
    {
      "family": "sql",
      "cases": [
        "sql.transaction-rollback",
        "sql.bindings-cursors",
        "sql.constraints",
        "sql.transaction-commit",
        "sql.mixed-rollback",
        "sql.consumed-write-cursor",
        "sql.open-read-cursor"
      ]
    },
    {
      "family": "cache",
      "cases": ["cache.documented-miss"]
    },
    {
      "family": "crypto",
      "cases": [
        "crypto.sha256-hmac",
        "crypto.aes-gcm",
        "crypto.ecdsa-p256",
        "crypto.key-derivation",
        "crypto.key-export",
        "crypto.invalid-input"
      ]
    },
    {
      "family": "web",
      "cases": ["web.html-rewriter"]
    },
    {
      "family": "messaging",
      "cases": ["messaging.message-channel", "messaging.event-source"]
    },
    {
      "family": "identity",
      "cases": ["identity.namespace"]
    },
    {
      "family": "concurrency",
      "cases": ["concurrency.input-gates", "concurrency.explicit-gate"]
    },
    {
      "family": "rpc",
      "cases": [
        "rpc.structured-clone",
        "rpc.thrown-error",
        "rpc.returned-target",
        "rpc.named-service"
      ]
    },
    {
      "family": "alarms",
      "cases": ["alarms.set-replace-delete", "alarms.fire", "alarms.retry"]
    },
    {
      "family": "streams",
      "cases": [
        "streams.tee",
        "streams.cancel",
        "streams.error",
        "streams.transform",
        "streams.backpressure",
        "streams.http-binary"
      ]
    },
    {
      "family": "websocket",
      "cases": ["websocket.protocol-attachment"]
    },
    {
      "family": "kv",
      "cases": ["kv.metadata-list", "kv.binary-pagination"]
    },
    {
      "family": "d1",
      "cases": ["d1.bindings-results", "d1.batch-rollback"]
    },
    {
      "family": "r2",
      "cases": [
        "r2.metadata-range-delete",
        "r2.conditional-write",
        "r2.multipart"
      ]
    },
    {
      "family": "queues",
      "cases": ["queues.batch-ack-retry"]
    },
    {
      "family": "workflows",
      "cases": [
        "workflows.steps-sleep-result",
        "workflows.retry",
        "workflows.event"
      ]
    },
    {
      "family": "node",
      "cases": [
        "node.buffer",
        "node.path-events",
        "node.async-context",
        "node.hash-compression",
        "node.util",
        "node.assert",
        "node.stream-timers"
      ]
    },
    {
      "family": "wasm",
      "cases": ["wasm.module"]
    },
    {
      "family": "assets",
      "cases": [
        "assets.binding",
        "assets.html-routing",
        "assets.redirects",
        "assets.worker-first"
      ]
    },
    {
      "family": "dynamic",
      "cases": [
        "dynamic.fetch",
        "dynamic.props",
        "dynamic.bindings",
        "dynamic.outbound",
        "dynamic.limits"
      ]
    },
    {
      "family": "facets",
      "cases": [
        "facets.isolation",
        "facets.transaction",
        "facets.outbound-transaction"
      ]
    },
    {
      "family": "context",
      "cases": ["context.wait-until"]
    },
    {
      "family": "repro",
      "cases": ["repro.body-readers", "repro.storage-errors"]
    }
  ],
  "excluded": [
    {
      "family": "AWS provisioning and distributed recovery",
      "reason": "AWS remains unqualified. Local distributed fault scenarios run separately in the recovery, multinode, fleet, resilience, and qualification suites; they are not API differential cases."
    },
    {
      "family": "Containers, Sandbox, and edge-only services",
      "reason": "Require a separate container runtime or managed Cloudflare environment; not implied by the local celld container."
    },
    {
      "family": "Cron, TCP/TLS, and managed Cloudflare service guarantees",
      "reason": "Require a clock-controlled or externally reachable reference environment; not established by Miniflare API emulation."
    },
    {
      "family": "PITR",
      "reason": "PITR-specific controls are not implemented. WebSocket hibernation is tested separately by dependencies.hibernation, with actual eviction and a surviving socket. Multi-node routing is covered by the multinode, fleet, and resilience suites."
    }
  ]
}
